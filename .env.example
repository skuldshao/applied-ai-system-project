# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
# Get a key at https://platform.claude.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use and how hard it thinks (low | medium | high).
# PAWPAL_MODEL=claude-haiku-5-5
# PAWPAL_EFFORT=low
